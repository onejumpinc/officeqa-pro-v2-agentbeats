{
  manifest_version: "0.1.0",
  config_schema: {
    type: "object",
    properties: {
      hf_token: { type: "string", secret: true },
    },
    required: ["hf_token"],
    additionalProperties: false,
  },
  slots: {
    proxy: { kind: "a2a" },
  },
  program: {
    // Immutable production image built from revision 59b6c681, whose shipped
    // scorer is pinned by the 739 evaluator-parity tests.
    image: "ghcr.io/onejumpinc/officeqa-pro-v2-benchmark@sha256:aaf5f408a99b02478b95f555ec96b2b4d420d996f0fb8cf77a9d9fcb31dcd124",
    entrypoint: "python server.py --host 0.0.0.0 --port 9009",
    env: {
      HF_TOKEN: "${config.hf_token}",
      AMBER_HINT_PROXY: "${slots.proxy}",
    },
    network: {
      endpoints: [{ name: "a2a_endpoint", port: 9009 }],
    },
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },
  exports: { a2a: "a2a" },
  metadata: {
    assessment_config: {
      tolerance: 0.0,
      timeout_seconds: 900,
      num_shards: 10,
    },
    participant_roles: ["agent"],
  },
}
